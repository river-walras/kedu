# 复制为 .env 并填入真实值(.env 已被 .gitignore 忽略,勿提交)。
# 脚本/pm2 通过 `uv run --env-file .env ...` 注入这些变量;交互式也可直接 jqlocal.auth(user, pwd)。

# ClickHouse(本地数据落库)
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=

# kedu_query 专用只读账户(必须在 ClickHouse 侧启用 readonly=1)
KEDU_READONLY_USER=agent
KEDU_READONLY_PASSWORD=

# JoinQuant jqdatasdk(仅建库/更新拉数时需要)
JQDATA_USER=
JQDATA_PASSWORD=
